{
    "name": "twila/credicarro",
    "description": "SDK oficial em PHP para a API de integração do Credicarro (financiamento e refinanciamento de veículos)",
    "type": "library",
    "license": "MIT",
    "keywords": ["credicarro", "financiamento", "refinanciamento", "sdk", "twila"],
    "homepage": "https://github.com/Twila-Digital/twila-credicarro-php-sdk",
    "authors": [
        {
            "name": "Twila Digital"
        }
    ],
    "support": {
        "issues": "https://github.com/Twila-Digital/twila-credicarro-php-sdk/issues",
        "docs": "https://documentacao.credicarro.com.br"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "guzzlehttp/guzzle": "^7.4.5",
        "guzzlehttp/psr7": "^1.9.1 || ^2.4.5",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^3.10",
        "symfony/yaml": "^5.4 || ^6.4 || ^7.0",
        "vimeo/psalm": "^5.26 || ^6.0"
    },
    "autoload": {
        "psr-4": {
            "Twila\\Credicarro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Twila\\Credicarro\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "phpcs"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
