<?xml version="1.0"?>
<ruleset name="Credicarro PHP SDK"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        PHPMD (usado pelo Codacy) com as convenções do SDK. Os ajustes abaixo seguem o desenho do SDK; o resto das
        regras vale como no padrão.
    </description>

    <rule ref="rulesets/cleancode.xml">
        <!-- Mappers, enums e factories são estáticos e sem estado por desenho (nada de container de DI). -->
        <exclude name="StaticAccess"/>
        <!-- As flags booleanas das opções espelham toggles documentados (retryOn500, disableAutomaticIdempotencyKey). -->
        <exclude name="BooleanArgumentFlag"/>
    </rule>

    <rule ref="rulesets/codesize.xml">
        <exclude name="ExcessiveParameterList"/>
        <exclude name="TooManyFields"/>
        <exclude name="TooManyPublicMethods"/>
    </rule>
    <!-- Os modelos espelham os payloads da API campo a campo (construtor e propriedades). -->
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="20"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="20"/>
        </properties>
    </rule>
    <!-- Wire concentra os leitores tipados do JSON (string, int, float, bool, data...). -->
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="15"/>
        </properties>
    </rule>

    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects"/>
    </rule>
    <!-- Os mappers e os clients conhecem todos os modelos de entrada e saída do recurso que atendem. -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="25"/>
        </properties>
    </rule>

    <rule ref="rulesets/naming.xml">
        <exclude name="LongVariable"/>
        <exclude name="ShortVariable"/>
        <exclude name="ShortMethodName"/>
    </rule>
    <!-- Os nomes seguem as opções documentadas (circuitBreakerSamplingDurationMs, documentUploadAttemptTimeoutMs). -->
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="35"/>
        </properties>
    </rule>
    <!-- $id (identificadores da API) e $v1 (client->v1, as rotas v1). -->
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id,v1"/>
        </properties>
    </rule>
    <!-- UuidGenerator::v4() é o nome da versão do UUID. -->
    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <property name="exceptions" value="v4"/>
        </properties>
    </rule>

    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
